# Brain Control Plane — server-side upstream (never use NEXT_PUBLIC_ for the key)
# Set on Vercel → Environment Variables → Production (+ Preview if needed).
# Redeploy after changing.

# Upstream Brain Runtime API (no trailing slash). Server-only.
BRAIN_API_URL=https://brain-api-live-production.up.railway.app

# Optional until Railway runs keyed main (v0.8+). Server-only — NOT NEXT_PUBLIC_.
# BRAIN_API_KEY=

# Optional label in the TopBar (safe to expose)
NEXT_PUBLIC_OPERATOR_ID=tyler
