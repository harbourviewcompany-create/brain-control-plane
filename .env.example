# Brain Control Plane — production wiring
# Set these in the Vercel project (Settings → Environment Variables).
# Redeploy after changing.

# Required for explicit production wiring (no trailing slash)
NEXT_PUBLIC_BRAIN_API_URL=https://brain-api-live-production.up.railway.app

# Required once Railway runs Brain main (v0.8+) with BRAIN_API_KEY set
# NEXT_PUBLIC_BRAIN_API_KEY=

# Optional operator label shown in TopBar
NEXT_PUBLIC_OPERATOR_ID=tyler
